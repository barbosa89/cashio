{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ai-spike": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_AI_SPIKE": "true"
      }
    },
    "voice-mvp": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_VOICE_TRANSACTIONS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
