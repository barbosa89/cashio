{
  "expo": {
    "name": "Cash IO",
    "slug": "cashio",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cashio",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-BR.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.omarbarbosa.cashio",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt-BR"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.omarbarbosa.cashio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E0F11",
            "image": "./assets/images/splash-icon.png"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "react-native-cloud-store",
        {
          "iCloud": {
            "documents": [
              {
                "containerId": "iCloud.com.omarbarbosa.cashio",
                "enabled": true,
                "visible": false
              }
            ],
            "environment": "Production"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#f97316",
          "defaultChannel": "financial-reminders"
        }
      ],
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "pt-BR"
            ],
            "android": [
              "en",
              "es",
              "pt-BR"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Cash IO to record a transaction for private processing on this device.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cash IO to select an image for the on-device AI compatibility test.",
          "cameraPermission": false
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": [
            "development",
            "ai-spike",
            "voice-mvp"
          ],
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "622c0043-2ea6-4549-ba8c-d3c50386d2ab"
      }
    }
  }
}
